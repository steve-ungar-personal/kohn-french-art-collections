---
import Base from '../../../layouts/Base.astro';
import { frames, frameThemes } from '../../../data/pages';
import { imageFor, pageHref, frameHref, absUrl, breadcrumbLd, SITE_NAME } from '../../../lib/site';

export function getStaticPaths() {
  return frames.filter((f) => f.pages.length).map((f) => ({ params: { frame: String(f.number) } }));
}

const n = Number(Astro.params.frame);
const frame = frames.find((f) => f.number === n)!;
const { title: heading, detail } = frameThemes[n];
const shown = frames.filter((f) => f.pages.length).map((f) => f.number);
const prev = shown[shown.indexOf(n) - 1];
const next = shown[shown.indexOf(n) + 1];
const proofKinds = ['Signed artist’s proof', 'Deluxe proof', 'Trial colour proof'];
const frameTitle = `Frame ${n}: ${heading}`;
const jsonLd = [
  {
    '@type': 'CollectionPage',
    name: frameTitle,
    url: absUrl(frameHref(n), Astro.site),
    isPartOf: { '@type': 'WebSite', name: SITE_NAME, url: absUrl('/', Astro.site) },
    mainEntity: {
      '@type': 'ItemList',
      numberOfItems: frame.pages.length,
      itemListElement: frame.pages.map((p, i) => ({
        '@type': 'ListItem',
        position: i + 1,
        url: absUrl(pageHref(p), Astro.site),
        name: p.title,
      })),
    },
  },
  breadcrumbLd([['Home', '/'], [n <= 8 ? `Frame ${n}` : heading, frameHref(n)]], Astro.site),
];
---
<Base title={frameTitle} description={`${detail}. ${frame.pages.length} album pages from the Kohn “Famous French Arts” exhibition.`} image={imageFor(n, 2).md} section="frames" jsonLd={jsonLd}>
  <div class="wrap">
    <nav class="crumbs"><a href="/">Home</a> / <a href="/#frames">Frames</a> / {n <= 8 ? `Frame ${n}` : heading}</nav>
    <header style="padding: 28px 0 36px; max-width: 760px;">
      <p class="eyebrow">{n <= 8 ? `Exhibition frame ${n} of 8` : n === 9 ? 'Miscellany' : n === 10 ? 'Binder pages' : 'Sheets & covers'}</p>
      <h1>{heading}</h1>
      <p class="lede">{detail}. {frame.pages.length} pages{n <= 8 ? ', shown in the order they were hung' : ''}.</p>
    </header>

    <div class="topnav">
      {prev ? <a href={frameHref(prev)} rel="prev">← Previous frame</a> : <span>← Previous frame</span>}
      {next ? <a href={frameHref(next)} rel="next">Next frame →</a> : <span>Next frame →</span>}
    </div>

    <div class="page-grid">
      {frame.pages.map((p) => (
        <a class="page-card" href={pageHref(p)}>
          <div class="img"><img src={imageFor(p.frame, p.index).thumb} alt={`Album page: ${p.title}`} width="640" height="780" loading="lazy" /></div>
          <div class="meta">
            <span class="n">Page {p.index}</span>
            <h3>{p.title}</h3>
            <ul class="chips">
              {p.kinds.slice(0, 3).map((k) => <li class={`chip ${proofKinds.includes(k) ? 'k-proof' : ''}`}>{k}</li>)}
            </ul>
          </div>
        </a>
      ))}
    </div>

    <nav class="pager" style="margin-top:48px">
      <div>{prev && <a href={frameHref(prev)}><small>← Previous frame</small>Frame {prev}</a>}</div>
      <div class="next">{next && <a href={frameHref(next)}><small>Next frame →</small>Frame {next}</a>}</div>
    </nav>
  </div>
</Base>
