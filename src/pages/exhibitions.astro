---
import Base from '../layouts/Base.astro';
import { exhibitRecord } from '../data/exhibitions';
import { imageFor } from '../lib/site';

const frenchArt = exhibitRecord.filter((r) => r.frenchArt);
const sheet = imageFor(11, 1);
const th = 'padding:8px;border-bottom:1px solid var(--rule)';
---
<Base title="Exhibitions and awards" description="The documented exhibition record of Milton and Janet Kohn, 1967–1984, including the awards won by the Famous French Arts exhibit." section="exhibitions">
  <div class="wrap">
    <header style="padding: 48px 0 24px; max-width: 800px;">
      <p class="eyebrow">The exhibits on the road</p>
      <h1>Exhibitions and awards, 1967–1984</h1>
      <p class="lede">
        <em>Famous French Arts</em> was shown and judged from 1967, two years after Milton Kohn took up stamps, until the early
        1980s. It won a gold medal in 1967, the Milwaukee Philatelic Society President’s Award in 1975, a silver in 1976 and an
        international bronze in Taipei in 1981. In 1970 it went to London for Philympia.
      </p>
    </header>

    <a href="/philympia/" class="frame-card" style="display:grid;grid-template-columns:120px 1fr;gap:20px;align-items:center;padding:14px;margin-bottom:40px;max-width:820px">
      <img src={sheet.thumb} alt="" width="120" height="156" style="width:120px;height:156px;object-fit:cover;object-position:top" />
      <div>
        <span class="num">1970 · London</span>
        <h3 style="margin:4px 0 6px">Philympia: Kohn’s own list of what he sent</h3>
        <p>Two handwritten sheets list the pages shipped to the international exhibition at Olympia, each linked to where it is in the collection today. →</p>
      </div>
    </a>

    <p style="font-family:var(--sans);font-size:.9rem;color:var(--ink-soft);max-width:800px">
      Sources are the stamp press of the time (<em>The American Philatelist</em>, the <em>Polonus Bulletin</em> and the
      <em>Wisconsin Federation of Stamp Clubs Bulletin</em>), read in the American Philatelic Research Library’s digital archive.
      Each source link opens the printed page. Rows marked ★ are the French art exhibit shown on this site; the others are the
      Kohns’ postal-history exhibits of concentration-camp mail.
    </p>
    <div style="overflow-x:auto;margin-top:16px">
      <table style="width:100%;border-collapse:collapse;font-size:.92rem;min-width:820px">
        <thead>
          <tr style="text-align:left;font-family:var(--sans);font-size:.72rem;letter-spacing:.08em;text-transform:uppercase;color:var(--ink-soft)">
            <th style={th}>Year</th><th style={th}>Exhibition</th><th style={th}>Exhibitor</th><th style={th}>Exhibit</th><th style={th}>Award</th><th style={th}>Source (printed page)</th>
          </tr>
        </thead>
        <tbody>
          {exhibitRecord.map((r) => (
            <tr style={r.frenchArt ? 'background:#f6ecee' : ''}>
              <td style={`${th};white-space:nowrap`}>{r.frenchArt ? '★ ' : ''}{r.year}</td>
              <td style={th}>{r.show}</td>
              <td style={th}>{r.who}</td>
              <td style={th}>{r.exhibit}</td>
              <td style={th}>{r.award}</td>
              <td style={`${th};font-family:var(--sans);font-size:.8rem`}><a href={r.source.url} rel="noopener">{r.source.label.replace('APRL digital library — ', '')}</a></td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>

    <section>
      <div class="split">
        <blockquote class="hand" style="margin:0">
          {frenchArt.filter((r) => r.quote).map((r) => (
            <p>“{r.quote}.” <a href={r.source.url} style="font-family:var(--sans);font-size:.75rem">{r.source.label.replace('APRL digital library — ', '')}</a></p>
          ))}
          <cite>The French art exhibit in the stamp press</cite>
        </blockquote>
        <div class="prose">
          <h2 style="font-size:1.5rem">Janet Kohn’s best in show</h2>
          <p>
            Janet Kohn exhibited in her own right. In November 1978 she won the Grand Award, best in show, at SUPEX ’78, the show
            of the Suburban Collectors Club of Chicago at Brookfield, Illinois, for “Concentration Camp Censor Markings”
            (<a href="https://digital.stamplibrary.org/ContentDmAdmin/ImageProxy.ashx?col=3&ptr=68959&sz=full">American Philatelist, Jan. 1979, p. 57</a>).
            She won medals at international exhibitions in Amsterdam, Prague, Vienna and Taipei.
          </p>
          <p>
            At ROCPEX Taipei ’81, where “French Art on Stamps” won a bronze, Milton was one of the U.S. commissioners. The signed
            dinner card in the <a href="/frames/9/15/">miscellany</a> dates from that trip.
          </p>
        </div>
      </div>
    </section>
  </div>
</Base>
