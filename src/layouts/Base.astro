---
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  image?: string;
  section?: 'home' | 'frames' | 'guide';
}

const {
  title,
  description = 'The Milton & Janet Kohn exhibition collection of French art stamps — signed artist’s proofs, deluxe proofs, first day covers, maximum cards and hand-drawn album pages, 1961–1969.',
  image = '/images/frame-1/03-md.webp',
  section,
} = Astro.props;
const fullTitle = title ? `${title} · Famous French Arts` : 'Famous French Arts — The Milton & Janet Kohn Collection';
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={image} />
    <meta property="og:type" content="website" />
    <meta name="theme-color" content="#8e1b2c" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Architects+Daughter&family=Cormorant+Garamond:ital,wght@0,500;0,600;1,500;1,600&family=Inter:wght@400;500;600&family=Source+Serif+4:ital,opsz,wght@0,8..60,400;0,8..60,600;1,8..60,400&display=swap"
    />
  </head>
  <body>
    <header class="site-header">
      <div class="wrap">
        <a class="brand" href="/">
          <span class="brand-mark" aria-hidden="true">K</span>
          <span class="brand-text">Famous French Arts<small>The Milton &amp; Janet Kohn Collection</small></span>
        </a>
        <nav class="nav" aria-label="Main">
          <a href="/#frames" aria-current={section === 'frames' ? 'page' : undefined}>Frames</a>
          <a class="opt" href="/#collectors">Collectors</a>
          <a href="/guide/" aria-current={section === 'guide' ? 'page' : undefined}>Guide</a>
        </nav>
      </div>
    </header>
    <main>
      <slot />
    </main>
    <footer class="site-footer">
      <div class="wrap">
        <span>Famous French Arts · assembled and hand-illustrated by Milton Kohn, exhibited by Milton &amp; Janet Kohn</span>
        <span><a href="/guide/#sources">Research notes &amp; sources</a></span>
      </div>
    </footer>
  </body>
</html>
