---
import '../styles/global.css';
import Analytics from '@vercel/analytics/astro';
import { SITE_NAME, absUrl, canonicalPath, seoTitle, seoDescription } from '../lib/site';

interface Props {
  title?: string;
  description?: string;
  image?: string;
  imageAlt?: string;
  /** Overrides the automatically shortened <title>. */
  metaTitle?: string;
  section?: 'home' | 'frames' | 'guide' | 'collectors' | 'exhibitions';
  /** schema.org nodes for this page (rendered together as one JSON-LD @graph). */
  jsonLd?: Record<string, unknown>[];
}

const {
  title,
  description = 'The Milton & Janet Kohn exhibition collection of French art stamps — signed artist’s proofs, deluxe proofs, first day covers, maximum cards and hand-drawn album pages, 1961–1969.',
  image = '/images/frame-1/03-md.webp',
  imageAlt,
  metaTitle: metaTitleOverride,
  section,
  jsonLd = [],
} = Astro.props;
const fullTitle = title ? `${title} · ${SITE_NAME}` : `${SITE_NAME} — The Milton & Janet Kohn Collection`;
const metaTitle = metaTitleOverride ?? seoTitle(title);
const metaDescription = seoDescription(description);
const canonical = absUrl(canonicalPath(Astro.url.pathname), Astro.site);
const imageUrl = absUrl(image, Astro.site);
const graph = jsonLd.length ? JSON.stringify({ '@context': 'https://schema.org', '@graph': jsonLd }) : '';
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{metaTitle}</title>
    <meta name="description" content={metaDescription} />
    <link rel="canonical" href={canonical} />
    <meta property="og:site_name" content={SITE_NAME} />
    <meta property="og:locale" content="en_US" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={metaDescription} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={imageUrl} />
    {imageAlt && <meta property="og:image:alt" content={imageAlt} />}
    <meta property="og:type" content="website" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={metaDescription} />
    <meta name="twitter:image" content={imageUrl} />
    {graph && <script type="application/ld+json" set:html={graph.replace(/</g, '\\u003c')} />}
    <meta name="theme-color" content="#8e1b2c" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Architects+Daughter&family=Cormorant+Garamond:ital,wght@0,500;0,600;1,500;1,600&family=Inter:wght@400;500;600&family=Source+Serif+4:ital,opsz,wght@0,8..60,400;0,8..60,600;1,8..60,400&display=swap"
    />
    <Analytics />
  </head>
  <body>
    <header class="site-header">
      <div class="wrap">
        <a class="brand" href="/">
          <span class="brand-mark" aria-hidden="true">K</span>
          <span class="brand-text">Famous French Arts<small>The Milton &amp; Janet Kohn Collection</small></span>
        </a>
        <nav class="nav" aria-label="Main">
          <a href="/#frames" aria-current={section === 'frames' ? 'page' : undefined}>Frames</a>
          <a href="/collectors/" aria-current={section === 'collectors' ? 'page' : undefined}>Collectors</a>
          <a href="/exhibitions/" aria-current={section === 'exhibitions' ? 'page' : undefined}>Exhibitions</a>
          <a href="/guide/" aria-current={section === 'guide' ? 'page' : undefined}>Guide</a>
        </nav>
      </div>
    </header>
    <main>
      <slot />
    </main>
    <footer class="site-footer">
      <div class="wrap">
        <span>Famous French Arts · assembled and hand-illustrated by Milton Kohn, exhibited by Milton &amp; Janet Kohn</span>
        <span><a href="/guide/#sources">Research notes &amp; sources</a></span>
        <p class="disclaimer">
          All information on this site is believed to be correct, but its accuracy cannot be guaranteed. For additional
          information, contact <a href="mailto:jkungar@earthlink.net">Judy Ungar</a> or
          <a href="mailto:edungar@earthlink.net">Ed Ungar</a>.
        </p>
      </div>
    </footer>
  </body>
</html>
